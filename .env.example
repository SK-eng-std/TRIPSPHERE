# TRIPSPHERE environment configuration
# Copy to .env (local) or set as Worker secrets (production). Never commit real keys.

# Required: HMAC signing key for session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# Optional: enables live AI itineraries and the conversational assistant.
# Without it the platform runs its built-in, data-driven planning engine (demo AI mode).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
